# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database Configuration (for PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=cbeam_db
DATABASE_USER=cbeam_user
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Security Settings
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
DJANGO_LOG_LEVEL=INFO
LOG_FILE_PATH=c-beamd/logs/c-beam.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# MQTT broker (c-beam publishes station state here)
# MQTT_CLIENT_PASSWORD was previously hardcoded in c-beamd/cbeamdcfg.py and is
# present in git history - rotate it on the broker before relying on this.
MQTT_CLIENT_NAME=c-beam
MQTT_CLIENT_PASSWORD=your-mqtt-password
MQTT_SERVER=c-beam.cbrp3.c-base.org
MQTT_SERVER_TLS=False
MQTT_SERVER_CERT=/etc/ssl/certs/c-beam-mqtt.crt
CBEAM_LOGFILE=/var/log/c-beam/c-beam.log

# Cookies - set both to True wherever c-beam is served over https
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Bootstrap superuser created by c-beamd/start (docker entrypoint).
# If DJANGO_SUPERUSER_PASSWORD is unset, the start script skips creating one.
DJANGO_SUPERUSER_NAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
