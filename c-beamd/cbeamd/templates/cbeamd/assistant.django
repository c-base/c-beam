{% extends "cbeamd/base.django" %}
{% load static %}

{% block title %}c-beam fragen{% endblock %}

{% block head %}
  <link href="{% static 'assistant.css' %}" rel="stylesheet">
{% endblock head %}

{% block content %}
  <div class="row">
    <div class="col-md-12">
      <h1 align="center">C-BEAM FRAGEN</h1>
      {% include "cbeamd/assistant_terminal.django" %}
    </div>
  </div>
{% endblock content %}

{% block extra_js %}
  <script src="{% static 'assistant.js' %}"></script>
{% endblock %}
