{% load static %}{% comment %}
the assistant's terminal, shared by / and /assistant. the page passes
`assistant_configured` (whether the ai server is set), `assistant_prompt_line`
(what stands after the first prompt) and optionally `assistant_lines` (plain
lines printed before the prompt line, e.g. the activity log). the page's head
block links assistant.css, its extra_js block loads assistant.js.
{% endcomment %}<div id="assistant" class="terminal"
     data-ask-url="{% url 'assistant_ask' %}"
     data-confirm-url="{% url 'assistant_confirm' %}"
     data-transcribe-url="{% url 'assistant_transcribe' %}"
     data-worklet-url="{% static 'assistant-worklet.js' %}"
     data-username="{{ user.username }}"
     data-model-url="{% url 'assistant_model' %}"
     data-configured="{{ assistant_configured|yesno:'1,0' }}"><div><span class="prompt">{{ user.username }}@c-beam&gt;</span> {{ assistant_prompt_line }}</div>{% for line in assistant_lines %}<div>{{ line }}</div>{% endfor %}{% if not assistant_configured %}<div class="line-error">fehler: KI-server nicht konfiguriert</div>{% endif %}<div id="assistant-line"><span class="prompt">{{ user.username }}@c-beam&gt;</span><input id="assistant-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="_" {% if not assistant_configured %}disabled{% endif %}></div></div>

<div id="assistant-record">&#9679; aufnahme la:uft <span id="assistant-time">0:00 / 0:20</span> <span id="assistant-level"></span></div>

<div id="assistant-controls">
  <label><input type="checkbox" id="assistant-speak"> antworten vorlesen</label>
  <button type="button" class="btn btn-default btn-sm" id="assistant-mic" style="display:none">&#127908; halten zum sprechen</button>
  <span id="assistant-mic-note" style="display:none">mikrofon: nur über https oder localhost</span>
  {% if assistant_models %}
  <label>modell
    <select id="assistant-model" class="input-sm">
      <option value="">{{ assistant_default_model }} (standard)</option>
      {% for model in assistant_models %}<option value="{{ model.id }}"{% if model.id == assistant_model %} selected{% endif %}>{{ model.id }}{% if model.labels %} [{{ model.labels|join:", " }}]{% endif %}</option>{% endfor %}
    </select>
  </label>
  {% endif %}
</div>
