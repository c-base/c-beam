{% extends "cbeamd/base.django" %}

{% block content %}

     <div class="row">
        <div class="col-md-12">
           <h1 align="center">c_leuse</h1>
           <a class="btn btn-block btn-lg btn-default btn-block" href="/c_leuse/set_stripe_pattern/off/"><b>Off</b></a>
           <a class="btn btn-block btn-lg btn-default btn-block" href="/c_leuse/set_stripe_pattern/rainbow/"><b>Rainbow</b></a>
           <a class="btn btn-block btn-lg btn-default btn-block" href="/c_leuse/set_stripe_pattern/notbeleuchtung/"><b>Notbeleuchtung</b></a>
           <a class="btn btn-block btn-lg btn-default btn-block" href="/c_leuse/set_stripe_pattern/scanning/"><b>Scanning</b></a>
           <a class="btn btn-block btn-lg btn-default btn-block" href="/c_leuse/set_stripe_pattern/success/"><b>Success</b></a>
           <a class="btn btn-block btn-lg btn-default btn-block" href="/c_leuse/set_stripe_pattern/failure/"><b>Failure</b></a>
        </div>
    </div>
    {% if result %}
        <script>alert("{{result}}");</script>
    {% endif %}

{% endblock content%}

