{% extends "cbeamd/base.django" %}

{% block content %}

     <div class="row">
        <div class="col-md-12">
           <h1 align="center">C-ONTROL</h1>
           <a class="btn btn-block btn-large btn-info" href="/control/"><b>Erde absprengen</b></a>
           <a class="btn btn-block btn-large btn-info" href="/control/"><b>Erde abstossen</b></a>
           <h1 align="center">C_LEUSEN-LED PATTERN</h1>
           <a class="btn btn-block btn-large btn-info" href="/control/set_stripe_pattern/off/"><b>Off</b></a>
           <a class="btn btn-block btn-large btn-info" href="/control/set_stripe_pattern/rainbow/"><b>Rainbow</b></a>
           <a class="btn btn-block btn-large btn-info" href="/control/set_stripe_pattern/notbeleuchtung/"><b>Notbeleuchtung</b></a>
           <a class="btn btn-block btn-large btn-info" href="/control/set_stripe_pattern/scanning/"><b>Scanning</b></a>
           <a class="btn btn-block btn-large btn-info" href="/control/set_stripe_pattern/success/"><b>Success</b></a>
           <a class="btn btn-block btn-large btn-info" href="/control/set_stripe_pattern/failure/"><b>Failure</b></a>
        </div>
    </div>
    {% if result %}
        <script>alert("{{result}}");</script>
    {% endif %}

{% endblock content%}

