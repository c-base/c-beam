{% comment %}
who is on board and who announced an eta, as the accordions of / and
/user/online. both pages include this inside #crew-list, and crew.js replaces
its contents from the crew_list_partial view every minute. crew_iframe shows
each member's crew page inline (/user/online) instead of a link (/).
{% endcomment %}
      <h1 align="center">AN BORD</h1>
      <div class="panel-group" id="user_accordion">
        {% for user in user_list_online %}
          <div class="panel">
            <a class="btn btn-block btn-default panel-heading"
                data-toggle="collapse" data-parent="#user_accordion"
                href="#CollapseUser{{ user.id }}" >
              {{ user.username }} ({{user.online_percentage}}&#37;)
            </a>
            <div id="CollapseUser{{ user.id }}" class="panel-collapse collapse">
              <div class="terminal">
                {% if crew_iframe %}<iframe src="https://{{ user.username }}.crew.c-base.org" width="100%" height="400px"></iframe>{% endif %}
                <table class="table{% if crew_iframe %} table-hover{% endif %}">
                  <tr><td>Username:</td><td> {{ user.username }}</td></tr>
                  <tr><td>Status:</td><td> {{ user.status }}</td></tr>
                  <tr><td>ETA:</td><td> {{ user.eta }}</td></tr>
                  <tr><td>ETD:</td><td> {{ user.etd }}</td></tr>
                  <tr><td>reminder:</td><td> {{ user.reminder }}</td></tr>
                  <tr><td>lastlocation:</td><td> {{ user.lastlocation }}</td></tr>
                  {% if not crew_iframe %}<tr><td>crew page:</td><td><a href="https://{{ user.username }}.crew.c-base.org">https://{{ user.username }}.crew.c-base.org</a></td></tr>{% endif %}
                </table>
              </div>
            </div>
          </div>
        {% empty %}
          <a class="btn btn-block btn-lg btn-default btn-block"><b>Niemand angemeldet.</b></a>
        {% endfor %}
      </div>
      {% if user_list_eta %}
      <h1 align="center">ETA</h1>
      <div class="panel-group" id="eta_accordion">
        {% for user in user_list_eta %}
          <div class="panel">
            <a class="btn btn-block btn-default panel-heading"
                data-toggle="collapse" data-parent="#eta_accordion"
                href="#CollapseEta{{ user.id }}" >
              {{ user.username }} ({{user.eta}})
            </a>
            <div id="CollapseEta{{ user.id }}" class="panel-collapse collapse">
              <div class="terminal">
                {% if crew_iframe %}<iframe src="https://{{ user.username }}.crew.c-base.org" width="100%" height="400px"></iframe>{% endif %}
                <table class="table">
                  <tr><td>Username:</td><td> {{ user.username }}</td></tr>
                  <tr><td>Status:</td><td> {{ user.status }}</td></tr>
                  <tr><td>ETA:</td><td> {{ user.eta }}</td></tr>
                  <tr><td>ETD:</td><td> {{ user.etd }}</td></tr>
                  <tr><td>reminder:</td><td> {{ user.reminder }}</td></tr>
                  <tr><td>lastlocation:</td><td> {{ user.lastlocation }}</td></tr>
                  {% if not crew_iframe %}<tr><td>crew page:</td><td><a href="https://{{ user.username }}.crew.c-base.org">https://{{ user.username }}.crew.c-base.org</a></td></tr>{% endif %}
                </table>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      {% endif %}
