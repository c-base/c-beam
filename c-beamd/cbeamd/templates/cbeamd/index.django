{% extends "cbeamd/base.django" %}
{% load static %}

{% block assistant %}{% endblock %}

{% block content %}

  <div class="row">
    <div class="col-md-12">
      <div id="crew-list" data-url="{% url 'crew_list_partial' %}">
      {% include "cbeamd/crew_list.django" %}
      </div>
      {# the activity log's terminal is the assistant's: the log is its first output, the prompt line below takes questions #}
      <div style="margin-top: 20px"></div>
      {% include "cbeamd/assistant_terminal.django" with assistant_prompt_line="tail activitylog" assistant_lines=activitylog %}
    </div>
  </div>

{% endblock content%}

{% block extra_js %}
  <script src="{% static 'crew.js' %}"></script>
{% endblock %}
