{% extends "cbeamd/base.django" %}
{% load static %}

{% block head %}
  <link href="{% static 'assistant.css' %}" rel="stylesheet">
{% endblock head %}

{% block content %}

  <div class="row">
    <div class="col-md-12">
      <h1 align="center">AN BORD</h1>
      <div class="panel-group" id="user_accordion">
        {% for user in user_list_online %}
          <div class="panel">
              <a class="btn btn-block btn-default panel-heading"
                  data-toggle="collapse" data-parent="#user_accordion" 
                  href="#CollapseUser{{ user.id }}" >
                {{ user.username }} ({{user.online_percentage}}&#37;)
              </a>
            <div id="CollapseUser{{ user.id }}" class="panel-collapse collapse">
              <div class="terminal">
                <table class="table">
                  <tr><td>Username:</td><td> {{ user.username }}</td></tr>
                  <tr><td>Status:</td><td> {{ user.status }}</td></tr>
                  <tr><td>ETA:</td><td> {{ user.eta }}</td></tr>
                  <tr><td>ETD:</td><td> {{ user.etd }}</td></tr>
                  <tr><td>reminder:</td><td> {{ user.reminder }}</td></tr>
                  <tr><td>lastlocation:</td><td> {{ user.lastlocation }}</td></tr>
                  <tr>
                    <td>crew page:</td>
                    <td>
                      <a href="https://{{ user.username }}.crew.c-base.org" width="100%" height="400px">https://{{ user.username }}.crew.c-base.org</a>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        {% empty %}
          <a class="btn btn-block btn-lg btn-default"><b>Niemand angemeldet.</b></a>
        {% endfor %}
      {% if user_list_eta %}
      <h1 align="center">ETA</h1>
      <div class="panel-group" id="user_accordion">
        {% for user in user_list_eta %}
          <div class="panel">
              <a class="btn btn-block btn-default panel-heading"
                  data-toggle="collapse" data-parent="#user_accordion" 
                  href="#CollapseUser{{ user.id }}" >
                {{ user.username }} ({{user.eta}})
              </a>
            <div id="CollapseUser{{ user.id }}" class="panel-collapse collapse">
              <div class="terminal">
                <table class="table">
                  <tr><td>Username:</td><td> {{ user.username }}</td></tr>
                  <tr><td>Status:</td><td> {{ user.status }}</td></tr>
                  <tr><td>ETA:</td><td> {{ user.eta }}</td></tr>
                  <tr><td>ETD:</td><td> {{ user.etd }}</td></tr>
                  <tr><td>reminder:</td><td> {{ user.reminder }}</td></tr>
                  <tr><td>lastlocation:</td><td> {{ user.lastlocation }}</td></tr>
                  <tr>
                    <td>crew page:</td>
                    <td>
                      <a href="https://{{ user.username }}.crew.c-base.org" width="100%" height="400px">https://{{ user.username }}.crew.c-base.org</a>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
      {# the activity log's terminal is the assistant's: the log is its first output, the prompt line below takes questions #}
      {% include "cbeamd/assistant_terminal.django" with assistant_prompt_line="tail activitylog" assistant_lines=activitylog %}
    </div>
  </div>

{% endblock content%}

{% block extra_js %}
  <script src="{% static 'assistant.js' %}"></script>
{% endblock %}

