{% extends 'cbeamd/base.django' %}

{% load bootstrap3 %}

{% block head %}
<style type="text/css">
  /* the form sits in the middle of what is left below the navbar (body has
     60px of padding-top for it); on small screens it just flows */
  .login-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 60px);
  }
  /* no grid columns here: their offset margins add up with the flex centring
     and push the box to the right */
  .login-wrap > .login-box { width: 100%; max-width: 360px; }
</style>
{% endblock head %}

{% block content %}

<div class="login-wrap">
  <div class="login-box">

    {% if oauth_enabled %}
    <a class="btn btn-primary btn-block" href="{% url 'oauth_login' %}?next={{ redirect_to|urlencode }}">
        mit c-base-account anmelden
    </a>
    <p class="text-muted text-center" style="margin: 1em 0">oder mit lokalem passwort:</p>
    {% endif %}

    <form action="/login/?next={{redirect_to}}" method="post" class="formi">
        {% csrf_token %}
        {% bootstrap_form form %}
        <div class="text-center">
            <button type="submit" class="btn btn-primary">
                Login
            </button>
        </div>
    </form>

    <div class="text-center" style="margin-top: 2em">
        <a href="https://play.google.com/store/apps/details?id=org.c_base.c_beam"><img src="/static/android-app-on-google-play.png" alt="c-beam bei google play"></a>
    </div>

  </div>
</div>

{% endblock content %}

{# the play-store link sits under the form here, not in the page footer #}
{% block footer %}{% endblock footer %}
