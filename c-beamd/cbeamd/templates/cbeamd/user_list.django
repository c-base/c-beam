{% extends "cbeamd/base.django" %}
{% load static %}

{% block content %}

  <div class="row">
    <div class="col-md-12">
      <div id="crew-list" data-url="{% url 'crew_list_partial' %}?iframe=1">
      {% include "cbeamd/crew_list.django" with crew_iframe=True %}
      </div>
    </div>
  </div>
  <br>

{% endblock content%}

{% block extra_js %}
  <script src="{% static 'crew.js' %}"></script>
{% endblock %}
