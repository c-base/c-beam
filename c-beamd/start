# 
# python /opt/c-beamd/c-beamd/manage.py runserver 0.0.0.0:4254
# exec so gunicorn replaces this shell as PID 1. without it bash is PID 1 and,
# lacking signal handlers, drops the SIGINT/SIGTERM the container runtime sends
# on ctrl-c or `stop` -- the container then hangs until the runtime SIGKILLs it.
# port 4254 is what the Dockerfile EXPOSEs and podman-compose.yml / the Makefile map.
exec gunicorn -w 10 --bind=0.0.0.0:4254 --log-level=warning cbeamd.wsgi:application --worker-class gthread --threads 4

