#! /bin/bash

cd /opt/c-beamd/cbeamd

python /opt/c-beamd/manage.py makemigrations
python /opt/c-beamd/manage.py migrate
python /opt/c-beamd/manage.py collectstatic

# bootstrap superuser.
# credentials come from the environment; if DJANGO_SUPERUSER_PASSWORD is unset we
# skip this entirely rather than baking a known password into the image.
if [ -n "$DJANGO_SUPERUSER_PASSWORD" ]; then
    DJANGO_SUPERUSER_USERNAME="${DJANGO_SUPERUSER_NAME:-admin}" \
    DJANGO_SUPERUSER_EMAIL="${DJANGO_SUPERUSER_EMAIL:-admin@example.com}" \
    python /opt/c-beamd/manage.py createsuperuser --noinput || \
        echo "superuser already exists, leaving it alone"
else
    echo "DJANGO_SUPERUSER_PASSWORD not set - skipping superuser creation"
fi

echo "from cbeamd.models import Status; s = Status(); s.save()" | python /opt/c-beamd/manage.py shell
echo "from cbeamd.models import Mission; m = Mission(); m.short_description = 'foo'; m.save()" | python /opt/c-beamd/manage.py shell

python /opt/c-beamd/manage.py runserver 0.0.0.0:8000
